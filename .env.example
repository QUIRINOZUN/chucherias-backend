# Copia este archivo a .env y llena los valores reales. .env nunca se sube
# a git (ver .gitignore) — cada quien (desarrollo local, Render) tiene el
# suyo con sus propios valores.

# Cadena de conexión a PostgreSQL (Neon).
DATABASE_URL=

# Secreto para firmar los JWT de sesión (jsonwebtoken). Cualquier cadena
# larga y aleatoria; cambiarla invalida todas las sesiones activas.
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma (sin espacios). En
# desarrollo normalmente http://localhost:4200; en producción, el dominio
# real de Vercel.
CORS_ORIGIN=

# Puerto del servidor local (Render lo asigna solo en producción).
PORT=3000

# Cloudinary (almacenamiento de imágenes — 2026-10-09, foto de producto).
# Se obtienen del dashboard de Cloudinary (cloudinary.com/console), plan
# gratuito, sin tarjeta.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
